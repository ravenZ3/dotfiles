#!/bin/bash
# Usage: pomo <name> [duration]
# Duration: plain number = minutes, e.g. 10, 25, 1h
# Examples:
#   pomo leetcode 10
#   pomo work 25
#   pomo break 5

NAME="${1:-work}"
RAW="${2:-25}"

if [[ "$RAW" =~ ^([0-9]+)h$ ]]; then
  TOTAL_SECS=$(( ${BASH_REMATCH[1]} * 3600 ))
elif [[ "$RAW" =~ ^([0-9]+)m?$ ]]; then
  TOTAL_SECS=$(( ${BASH_REMATCH[1]} * 60 ))
else
  echo "Invalid duration: $RAW" >&2
  exit 1
fi

HRS=$((TOTAL_SECS / 3600))
MINS=$(( (TOTAL_SECS % 3600) / 60 ))
SECS=$((TOTAL_SECS % 60))
LABEL="$( (( HRS > 0 )) && echo "${HRS}h" )$( (( MINS > 0 )) && echo "${MINS}m" )$( (( SECS > 0 )) && echo "${SECS}s" )"

if [[ "$XDG_CURRENT_DESKTOP" == "Hyprland" ]]; then
  UPDATE_INTERVAL=1
else
  UPDATE_INTERVAL=30
fi

EXPIRE_MS=$(( UPDATE_INTERVAL * 1000 + 5000 ))
NOTIF_ID=$(notify-send --print-id -u normal -h int:value:0 --expire-time $EXPIRE_MS "$NAME" "${LABEL} remaining")

# Watch for user dismissing the notification
DISMISS_FLAG=$(mktemp)
gdbus monitor --session --dest org.freedesktop.Notifications 2>/dev/null \
  | grep --line-buffered "NotificationClosed" \
  | while IFS= read -r line; do
      [[ "$line" == *"uint32 $NOTIF_ID,"* ]] && echo 1 > "$DISMISS_FLAG"
    done &
MONITOR_PID=$!

_update() {
  local progress=$1 body=$2
  if [[ "$XDG_CURRENT_DESKTOP" == "Hyprland" ]]; then
    gdbus call --session \
      --dest org.freedesktop.Notifications \
      --object-path /org/freedesktop/Notifications \
      --method org.freedesktop.Notifications.Notify \
      "pomo" "$NOTIF_ID" "" "$NAME" "$body" \
      "[]" "{'value': <int32 $progress>}" \
      "int32 0" > /dev/null
  else
    notify-send -r "$NOTIF_ID" -u normal \
      -h int:value:$progress \
      --expire-time $EXPIRE_MS \
      "$NAME" "$body"
  fi
}

elapsed=0
while (( elapsed < TOTAL_SECS )); do
  sleep_time=$UPDATE_INTERVAL
  (( elapsed + sleep_time > TOTAL_SECS )) && sleep_time=$(( TOTAL_SECS - elapsed ))
  sleep "$sleep_time"
  elapsed=$(( elapsed + sleep_time ))
  remaining=$(( TOTAL_SECS - elapsed ))
  progress=$(( elapsed * 100 / TOTAL_SECS ))
  rmins=$(( remaining / 60 ))
  rsecs=$(( remaining % 60 ))
  [[ ! -s "$DISMISS_FLAG" ]] && (( remaining > 0 )) && _update "$progress" "${rmins}m ${rsecs}s remaining"
done

kill "$MONITOR_PID" 2>/dev/null
rm -f "$DISMISS_FLAG"

paplay /usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga &>/dev/null

choice=$(notify-send -r "$NOTIF_ID" -u critical \
  --action="work=New Work 25m" \
  --action="break=Break 5m" \
  --action="long=Long Break 15m" \
  "$NAME done!" "Finished ${LABEL} session")

case "$choice" in
  work)  pomo work 25  ;;
  break) pomo break 5  ;;
  long)  pomo long 15  ;;
esac
